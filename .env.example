# Jarvis Hub secrets and settings. Copy to .env and keep it private (chmod 600).

TZ=Asia/Kolkata

# Home stack
PIHOLE_PASSWORD=change-me
FILEBROWSER_PASSWORD=change-me
JELLYFIN_URL=http://localhost:8096
PUID=1000
PGID=1000

# Speech + daily brain (required)
GROQ_API_KEY=

# Optional: OpenAI-compatible / alternative brains (Gemini, Claude, OpenRouter)
# Set the base URL and model in the dashboard or route picker.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional note dispatch
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JARVIS_WEBHOOK_URL=

# Optional WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# Optional Spotify control
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REFRESH_TOKEN=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8899/callback
